-- 1. DATABASE CREATION
CREATE DATABASE IF NOT EXISTS StudentManagement;
USE StudentManagement;

-- Drop existing tables to allow fresh execution
DROP TABLE IF EXISTS Results;
DROP TABLE IF EXISTS Enrollments;
DROP TABLE IF EXISTS Courses;
DROP TABLE IF EXISTS Students;


-- ============================================================
-- 2. CREATE TABLES
-- ============================================================

-- STUDENTS TABLE
CREATE TABLE Students (
    student_id INT PRIMARY KEY AUTO_INCREMENT,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE,
    department VARCHAR(50)
);

-- COURSES TABLE
CREATE TABLE Courses (
    course_id INT PRIMARY KEY AUTO_INCREMENT,
    course_name VARCHAR(100) NOT NULL,
    credits INT NOT NULL,
    CONSTRAINT chk_course_credits CHECK (credits > 0)
);

-- ENROLLMENTS TABLE
CREATE TABLE Enrollments (
    enrollment_id INT PRIMARY KEY AUTO_INCREMENT,
    student_id INT NOT NULL,
    course_id INT NOT NULL,
    enrollment_date DATE NOT NULL,

    CONSTRAINT fk_enrollment_student
        FOREIGN KEY (student_id)
        REFERENCES Students(student_id),

    CONSTRAINT fk_enrollment_course
        FOREIGN KEY (course_id)
        REFERENCES Courses(course_id),

    CONSTRAINT uq_student_course
        UNIQUE (student_id, course_id)
);

-- RESULTS TABLE
CREATE TABLE Results (
    result_id INT PRIMARY KEY AUTO_INCREMENT,
    enrollment_id INT NOT NULL UNIQUE,
    marks DECIMAL(5,2) NOT NULL,
    grade VARCHAR(5) NOT NULL,

    CONSTRAINT fk_result_enrollment
        FOREIGN KEY (enrollment_id)
        REFERENCES Enrollments(enrollment_id),

    CONSTRAINT chk_marks
        CHECK (marks >= 0 AND marks <= 100)
);


