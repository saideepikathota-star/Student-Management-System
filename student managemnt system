-- ============================================================
-- 16. INNER JOIN - STUDENT COURSE DETAILS
-- ============================================================

SELECT
    s.student_id,
    s.full_name,
    c.course_name,
    e.enrollment_date
FROM Students s
INNER JOIN Enrollments e
    ON s.student_id = e.student_id
INNER JOIN Courses c
    ON e.course_id = c.course_id
ORDER BY s.student_id;


-- ============================================================
-- 17. STUDENT MARKS AND GRADES
-- ============================================================

SELECT
    s.student_id,
    s.full_name,
    c.course_name,
    r.marks,
    r.grade
FROM Students s
JOIN Enrollments e
    ON s.student_id = e.student_id
JOIN Courses c
    ON e.course_id = c.course_id
JOIN Results r
    ON e.enrollment_id = r.enrollment_id
ORDER BY s.full_name;


-- ============================================================
-- 18. AVERAGE MARKS FOR EACH COURSE
-- ============================================================

SELECT
    c.course_name,
    ROUND(AVG(r.marks), 2) AS average_marks
FROM Courses c
JOIN Enrollments e
    ON c.course_id = e.course_id
JOIN Results r
    ON e.enrollment_id = r.enrollment_id
GROUP BY c.course_id, c.course_name;


-- ============================================================
-- 19. HIGHEST SCORING STUDENT IN EACH COURSE
-- ============================================================

SELECT
    c.course_name,
    s.full_name,
    r.marks
FROM Results r
JOIN Enrollments e
    ON r.enrollment_id = e.enrollment_id
JOIN Students s
    ON e.student_id = s.student_id
JOIN Courses c
    ON e.course_id = c.course_id
WHERE (e.course_id, r.marks) IN (
    SELECT
        e2.course_id,
        MAX(r2.marks)
    FROM Results r2
    JOIN Enrollments e2
        ON r2.enrollment_id = e2.enrollment_id
    GROUP BY e2.course_id
);


-- ============================================================
-- 20. STUDENTS SCORING 80 OR ABOVE
-- ============================================================

SELECT
    s.full_name,
    c.course_name,
    r.marks,
    r.grade
FROM Students s
JOIN Enrollments e
    ON s.student_id = e.student_id
JOIN Courses c
    ON e.course_id = c.course_id
JOIN Results r
    ON e.enrollment_id = r.enrollment_id
WHERE r.marks >= 80
ORDER BY r.marks DESC;


-- ============================================================
-- 21. STUDENT PERFORMANCE REPORT
-- ============================================================

SELECT
    s.student_id,
    s.full_name,
    COUNT(r.result_id) AS courses_completed,
    ROUND(AVG(r.marks), 2) AS average_marks,
    MAX(r.marks) AS highest_marks,
    MIN(r.marks) AS lowest_marks
FROM Students s
JOIN Enrollments e
    ON s.student_id = e.student_id
JOIN Results r
    ON e.enrollment_id = r.enrollment_id
GROUP BY s.student_id, s.full_name
ORDER BY average_marks DESC;


